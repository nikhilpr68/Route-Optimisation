NODE_ENV=development
PORT=5001

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://route-optimization-mu.vercel.app/,http://localhost:5173

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db-name>

# Secret key for signing JWT tokens
JWT_SECRET=replace-with-a-strong-secret

# Google Maps and OAuth
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Pipeline trace logs (set to true for debugging)
PIPELINE_TRACE=true
PIPELINE_TRACE_PRINT_PROMPT=true
PIPELINE_TRACE_PRINT_LLM_RAW=true

# Mail (SMTP via Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM="Route Optimizer <your-email@gmail.com>"

# Road distance backend (OSRM)
# Tip: include scheme (http/https). If omitted, code assumes http://
DISTANCE_METRIC=osrm
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
REQUIRE_ROAD_DISTANCE=false
