# Google Maps API key (used for map rendering and directions)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google OAuth Client ID (used for Google sign-in)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API base URL (comma-separated for multiple backends)
VITE_API_BASE_URL=https://route-optimization-khn7.onrender.com/,https://route-optimization-psi.vercel.app/

# Fallback API base URL (used when primary is down)
VITE_API_BASE_URL_FALLBACK=http://localhost:5001

# Set to true to force using the fallback URL
VITE_API_USE_FALLBACK=true
